{
    "manifest_version": 3,
    "name": "Pixiv 图片提取",
    "version": "1.2",
    "description": "提取 Pixiv 作品页面的高清图片，支持预览、勾选、批量下载",
    "permissions": [
        "activeTab",
        "downloads",
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "https://www.pixiv.net/*",
        "https://i.pximg.net/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Pixiv 图片提取"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.pixiv.net/artworks/*",
                "https://www.pixiv.net/illust/*",
                "https://www.pixiv.net/users/*/artworks/*"
            ],
            "js": ["content.js"]
        }
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "pixiv_referer",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}
